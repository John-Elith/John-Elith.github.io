---
/**
 * Hero — el panel de presentación del boceto: texto a la izquierda, retrato
 * a la derecha, todo dentro de una sola tarjeta de cristal.
 *
 * En móvil el retrato pasa arriba y se encoge, porque un rostro grande sobre
 * un móvil vertical desplaza el titular por debajo del pliegue.
 */
import Icon from './Icon.astro';
import Boton from './Boton.astro';
import { identidad, contacto } from '@/data/perfil';
import { existeEnPublico } from '@/lib/archivos';

// Los roles se rotan por JS. Mandamos la lista en un atributo de datos y
// dejamos el primero escrito en el HTML: si el JS no llega a ejecutarse,
// la frase sigue estando completa y siendo indexable.
const roles = identidad.roles;

// Mientras no subas estos archivos a `public/`, no los enlazamos.
const hayFoto = existeEnPublico(identidad.foto);
const hayCv = existeEnPublico(identidad.cv);
---

<section id="inicio" class="hero" aria-labelledby="hero-titulo">
  <div class="hero__tarjeta vidrio vidrio--alto vidrio--xl vidrio--interactivo" data-brillo>
    <div class="hero__texto">
      {
        identidad.disponibilidad && (
          <p class="estado" data-revelar="arriba">
            <span class="estado__punto" />
            {identidad.disponibilidad}
          </p>
        )
      }

      <h1 id="hero-titulo" class="hero__titular" data-revelar="arriba" style="--retardo: 80ms">
        Desarrollador de software
        <span class="texto-degradado">Full Stack</span>
      </h1>

      {/* Rotador de especialidades. `aria-live` está deliberadamente ausente:
          es decorativo y anunciarlo cada 3 s sería insoportable con lector
          de pantalla. El texto completo está en la sección de habilidades. */}
      <p class="hero__roles" data-revelar="arriba" style="--retardo: 160ms">
        <span class="hero__roles-fijo">Especializado en</span>
        <span class="hero__roles-ventana">
          <span class="hero__roles-item" data-roles={JSON.stringify(roles)}>{roles[0]}</span>
        </span>
      </p>

      <p class="hero__eslogan" data-revelar="arriba" style="--retardo: 240ms">
        {identidad.eslogan}
      </p>

      <div class="hero__acciones" data-revelar="arriba" style="--retardo: 320ms">
        <Boton href="#contacto" variante="primario" icono="sobre" iconoDerecha="flecha-derecha">
          Contáctame
        </Boton>
        <Boton href="#proyectos" variante="secundario" icono="codigo">Ver proyectos</Boton>
        {
          hayCv && (
            <Boton href={identidad.cv!} variante="fantasma" icono="descargar" externo>
              Descargar CV
            </Boton>
          )
        }
      </div>

      <ul class="hero__meta" role="list" data-revelar="arriba" style="--retardo: 400ms">
        <li>
          <Icon nombre="ubicacion" tam="1rem" />
          {identidad.ubicacion}
        </li>
        <li>
          <Icon nombre="sobre" tam="1rem" />
          <a class="enlace-sub" href={`mailto:${contacto.email}`}>{contacto.email}</a>
        </li>
      </ul>
    </div>

    {/* ── Retrato ───────────────────────────────────────────────────── */}
    <div class="hero__retrato" data-revelar="escala" style="--retardo: 200ms">
      <div class="retrato__marco">
        {
          hayFoto && (
            <img
              class="retrato__img"
              src={identidad.foto}
              alt={identidad.fotoAlt}
              width="440"
              height="520"
              fetchpriority="high"
              decoding="async"
              data-foto
            />
          )
        }
        {/* Se ve solo mientras no hayas puesto tu foto en `public/`. */}
        <span class="retrato__marcador" aria-hidden="true">{identidad.iniciales}</span>
      </div>

      {/* Chapa flotante sobre la esquina del retrato. */}
      <div class="retrato__chapa vidrio">
        <Icon nombre="codigo" tam="1rem" />
        <span>C# · .NET</span>
      </div>
    </div>
  </div>

  <a class="hero__bajar" href="#sobre-mi" aria-label="Ir a la biografía">
    <span>Desliza</span>
    <Icon nombre="chevron-abajo" tam="1.1rem" />
  </a>
</section>

<style>
  .hero {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--e-6);
    /* `svh` respeta la barra del navegador móvil, que en `vh` provoca saltos
       al aparecer y desaparecer al hacer scroll. */
    min-height: min(100svh, 52rem);
    justify-content: center;
    padding-block: calc(var(--alto-barra) + var(--e-6)) var(--e-6);
  }

  .hero__tarjeta {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--e-6);
    padding: clamp(1.5rem, 4vw, 3.25rem);
  }

  .hero__texto {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--e-4);
    min-width: 0;
  }

  .hero__titular {
    /* Un pelín más grande que el h1 base: es el ancla visual de la página. */
    font-size: clamp(2.35rem, 1.6rem + 3.4vw, 4.4rem);
  }

  /* ── Rotador de roles ──────────────────────────────────────────────── */

  .hero__roles {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5ch;
    font-size: var(--ts-lg);
    font-family: var(--f-titulo);
    color: var(--t-suave);
  }

  .hero__roles-ventana {
    display: inline-block;
    position: relative;
    /* Recorta el texto que entra y sale por arriba y por abajo. */
    overflow: hidden;
    /* Alto fijo: sin esto el layout salta cada vez que cambia el texto. */
    height: 1.5em;
    vertical-align: bottom;
  }

  .hero__roles-item {
    display: inline-block;
    font-weight: 600;
    color: var(--c-acento-claro);
    white-space: nowrap;
    transition:
      transform var(--d-normal) var(--cv-salida),
      opacity var(--d-normal) var(--cv-salida);
  }

  /* Estados que alterna el JS al cambiar de rol. */
  .hero__roles-item[data-fase='sale'] {
    transform: translateY(-110%);
    opacity: 0;
  }

  .hero__roles-item[data-fase='entra'] {
    transform: translateY(110%);
    opacity: 0;
    transition: none;
  }

  .hero__eslogan {
    max-width: 46ch;
    font-size: var(--ts-md);
    color: var(--t-normal);
  }

  .hero__acciones {
    display: flex;
    flex-wrap: wrap;
    gap: var(--e-3);
    margin-top: var(--e-2);
  }

  .hero__meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--e-2) var(--e-5);
    margin: var(--e-2) 0 0;
    padding: 0;
    list-style: none;
    font-size: var(--ts-sm);
    color: var(--t-suave);
  }

  .hero__meta li {
    display: inline-flex;
    align-items: center;
    gap: var(--e-2);
  }

  .hero__meta :global(.icono) {
    color: var(--c-acento);
  }

  /* ── Retrato ───────────────────────────────────────────────────────── */

  .hero__retrato {
    position: relative;
    justify-self: center;
    width: min(20rem, 78vw);
  }

  .retrato__marco {
    position: relative;
    display: grid;
    place-items: center;
    aspect-ratio: 4 / 5;
    border-radius: var(--r-xl);
    overflow: hidden;
    border: 1px solid var(--v-borde-vivo);
    background: linear-gradient(150deg, var(--c-musgo), var(--c-pizarra) 45%, var(--c-tinta));
    box-shadow: var(--s-alta);
  }

  .retrato__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 1;
    /* La imagen entra en color al pasar el cursor; en reposo va ligeramente
       desaturada para integrarse con el verde grisáceo del fondo. */
    filter: saturate(0.8) contrast(1.05);
    transition:
      transform var(--d-lenta) var(--cv-salida),
      filter var(--d-lenta) var(--cv-salida);
  }

  .hero__tarjeta:hover .retrato__img {
    transform: scale(1.04);
    filter: saturate(1) contrast(1);
  }

  /* Monograma de reserva, detrás de la imagen. */
  .retrato__marcador {
    font-family: var(--f-titulo);
    font-size: clamp(3rem, 9vw, 5rem);
    font-weight: 700;
    letter-spacing: 0.05em;
    color: rgb(var(--rgb-hueso) / 0.22);
  }

  /* Brillo diagonal fijo que refuerza la lectura de "cristal". */
  .retrato__marco::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 2;
    background: linear-gradient(160deg, rgb(255 255 255 / 0.16) 0%, transparent 35%);
    pointer-events: none;
  }

  .retrato__chapa {
    position: absolute;
    inset-block-end: -0.9rem;
    inset-inline-start: -0.9rem;
    z-index: 3;
    display: inline-flex;
    align-items: center;
    gap: var(--e-2);
    padding: 0.55rem 0.95rem;
    border-radius: var(--r-pastilla);
    font-family: var(--f-mono);
    font-size: var(--ts-xs);
    color: var(--t-fuerte);
    animation: flotar 7s var(--cv-suave) infinite;
  }

  .retrato__chapa :global(.icono) {
    color: var(--c-acento-claro);
  }

  /* ── Indicador de scroll ───────────────────────────────────────────── */

  .hero__bajar {
    display: none;
    align-self: center;
    align-items: center;
    gap: var(--e-1);
    flex-direction: column;
    font-family: var(--f-mono);
    font-size: var(--ts-xs);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--t-tenue);
    transition: color var(--tr-base);
  }

  .hero__bajar:hover {
    color: var(--c-acento-claro);
  }

  .hero__bajar :global(.icono) {
    animation: rebote-suave 2.2s var(--cv-suave) infinite;
  }

  /* ── Escalado ──────────────────────────────────────────────────────── */

  @media (min-width: 40rem) {
    .hero__bajar {
      display: flex;
    }
  }

  /* A partir de aquí cabe el retrato al lado del texto, como en el boceto. */
  @media (min-width: 56rem) {
    .hero__tarjeta {
      grid-template-columns: minmax(0, 1.35fr) minmax(0, 0.85fr);
      align-items: center;
      gap: var(--e-7);
    }

    .hero__retrato {
      width: 100%;
      max-width: 22rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .retrato__chapa,
    .hero__bajar :global(.icono) {
      animation: none;
    }

    .hero__tarjeta:hover .retrato__img {
      transform: none;
    }
  }
</style>
